# Copy to .env.local. Next.js only exposes NEXT_PUBLIC_-prefixed vars to the
# browser, and everything here ships in the client bundle — so only
# publishable / anon values belong here.

# storefront-api base URL
NEXT_PUBLIC_STOREFRONT_API_URL=http://localhost:3001

# This deployment's own public origin — used to build absolute URLs for
# metadataBase (OG/Twitter image tags), canonical links, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Account-scoped storefront API key — a publishable-style key, safe to ship
# in client code (see the SDK's README). Create one in your merchant-web
# account under Settings → Developer API keys.
NEXT_PUBLIC_APP_KEY=sfk_xxx

# Your platform's Stripe test-mode *publishable* key (pk_test_...). Loaded
# via loadStripe(pk, { stripeAccount }) for the embedded checkout on
# /checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
